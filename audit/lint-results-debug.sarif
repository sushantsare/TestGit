                                    "startLine": 67,
                                    "endLine": 72,
                                    "snippet": {
                                        "text": "    fun update(block: (Settings) -> Settings) {\n        val n = block(_s.value)\n        sp.edit()\n            .putBoolean(\"setupDone\", n.setupDone).putString(\"theme\", n.theme.name)\n            .putBoolean(\"hideAmounts\", n.hideAmounts).putBoolean(\"lockOn\", n.lockOn).putInt(\"lockAfterSec\", n.lockAfterSec)\n"
                                    }
                                }
                            }
                        }
                    ],
