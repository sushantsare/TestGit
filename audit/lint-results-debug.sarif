                                        "text": "        else \"Hi ${p.name}, just a gentle reminder about the $amt pending with you. Please return it when convenient. Thanks!\"\n        val digits = p.phone.filter { it.isDigit() }.let { if (it.length == 10) \"91$it\" else it }\n        val uri = if (digits.isNotEmpty()) Uri.parse(\"https://wa.me/$digits?text=\" + Uri.encode(msg)) else Uri.parse(\"https://wa.me/?text=\" + Uri.encode(msg))\n        runCatching { ctx.startActivity(Intent(Intent.ACTION_VIEW, uri).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) }\n            .onFailure { runCatching { ctx.startActivity(Intent.createChooser(Intent(Intent.ACTION_SEND).setType(\"text/plain\").putExtra(Intent.EXTRA_TEXT, msg), \"Send reminder\").addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) } }\n"
                                    }
                                }
                            }
                        }
