<?xml version="1.0" encoding="utf-8"?>
<!-- Locked notes are encrypted with a key that never leaves this phone, and the PIN must not travel,
     so Android cloud backup / device transfer are switched off. Users back up with Settings › Back up all notes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
