<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Grabbit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch screen (AndroidX SplashScreen): brand icon on the app background, shown only while the app starts -->
    <style name="Theme.Grabbit.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#10B981</item>
        <item name="postSplashScreenTheme">@style/Theme.Grabbit</item>
    </style>

    <!-- Share sheet: transparent window so the sheet floats over the app the user shared from -->
    <style name="Theme.Grabbit.Share" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
