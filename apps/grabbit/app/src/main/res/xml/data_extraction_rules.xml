<?xml version="1.0" encoding="utf-8"?>
<!-- Only settings are backed up. Login cookies (cookies.txt) and the download list never leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="grabbit.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="grabbit.xml" />
    </device-transfer>
</data-extraction-rules>
